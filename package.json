{
  "name": "osctl",
  "version": "0.0.0",
  "description": "An interactive terminal client for OpenSearch operations",
  "license": "MIT",
  "author": "Josep Boix Requesens",
  "homepage": "https://github.com/jboix/osctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/osctl.git"
  },
  "bugs": {
    "url": "https://github.com/jboix/osctl/issues"
  },
  "keywords": [
    "opensearch",
    "cli",
    "repl",
    "terminal",
    "ink"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "osctl": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "docs/design"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "lint": "biome check .",
    "format": "biome format --write .",
    "arch": "depcruise src scripts --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.tsx --compile --outfile dist/osctl",
    "build:all": "bun run scripts/build.ts",
    "env:up": "docker compose up -d --wait",
    "env:up:secure": "docker compose --profile secure up -d --wait",
    "env:stop": "docker compose --profile secure stop",
    "env:down": "docker compose --profile secure down -v",
    "verify": "bun run lint && bun run arch && bun run knip && bun run typecheck && bun run test && bun run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.18",
    "dependency-cruiser": "^18.1.1",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-router": "^8.3.0"
  }
}
